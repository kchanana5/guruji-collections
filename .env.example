# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-side only; never expose in client code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Razorpay (server-side secret; Key ID may be exposed to checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (server-side only)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
